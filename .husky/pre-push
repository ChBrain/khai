#!/usr/bin/env sh
# KHAI-Guard: block a push that would mix source and test changes in a single
# PR range (compare branch tip against its merge-base with origin/main).
npx khai-guard

# KHAI-Guard branch-scope: the branch NAME must classify into a lane, and the
# branch's diff range must stay inside that lane. ENFORCED (exit 1 on a
# violation). Pick the lane with `khai-guard advise --files <paths>` before
# `git checkout -b`; see docs/BRANCHING.md.
#
# The hook receives the branch being pushed on stdin.
# Format: <local ref> <local sha> <remote ref> <remote sha>
while read local_ref local_sha remote_ref remote_sha
do
  case "$local_ref" in
    refs/heads/*)
      branch_name="${local_ref#refs/heads/}"
      echo "KHAI-Guard: checking branch '$branch_name'..."
      npx khai-guard branch-check --branch "$branch_name"
      ;;
  esac
done

# KHAI-Guard bump-scope: flag a non-patch release scope. minor/major is the
# maintainer's call; this prints the loud banner locally so you see it before
# the PR exists. Advisory -- never blocks the push (CI stamps the label).
npx khai-guard bump-check

# KHAI-Guard lockfile-check: three questions about the root lockfile, all
# ENFORCED. (1) No lockfile committed inside a package: this is an npm-workspaces
# monorepo, the root package-lock.json is the only authoritative lock, and a stray
# nested one desyncs Dependabot and CI. (2) It still matches the manifests, which
# is what CI's `npm ci` asks at install. (3) It still carries every platform's
# binaries, which `npm ci` does NOT ask -- a lockfile rebuilt from scratch records
# only the machine that rebuilt it, installs perfectly there, and removes the
# host's own binaries everywhere else.
#
# The name says lockfile and it means all three. This comment described only the
# first for two releases after the others landed, so a reader debugging a
# lockfile-check failure went looking for a nested lockfile that was never there.
npx khai-guard lockfile-check

# KHAI-Guard member-scope: one phenomenon, one engine. A member stem another
# engine already claims (or that restates a whole engine's domain) is a
# duplicate reading; thin it to a pointer at the owner, or the maintainer
# whitelists a same-word-different-science homonym. ENFORCED.
npx khai-guard member-check
