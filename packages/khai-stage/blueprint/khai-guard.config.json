{
  "source": ["plays/**"],
  "test": ["tests/**", ".github/workflows/**", ".husky/**"],
  "exemptRenames": true,
  "gates": [
    {
      "name": "prettier",
      "command": "npx prettier --check .",
      "fix": "npx prettier --write ."
    },
    {
      "name": "suite",
      "command": "npx vitest run"
    },
    {
      "name": "khai-guard",
      "command": "npx khai-guard"
    },
    {
      "name": "branch-check",
      "command": "npx khai-guard branch-check"
    },
    {
      "name": "changeset-check",
      "command": "npx khai-guard changeset-check"
    }
  ],
  "changesetPolicy": {
    "countDrivenAdd": ["plays/*/play_*.md"]
  },
  "driftPolicy": {
    "scopes": ["@chbrain/"]
  },
  "licensePolicy": {
    "packages": ["package.json"],
    "packageLicenses": ["SEE LICENSE IN LICENSE and LICENSE-CODE"]
  },
  "branchScope": {
    "shared": [
      "package.json",
      "package-lock.json",
      "CHANGELOG.md",
      ".prettierrc",
      ".prettierignore",
      ".gitignore",
      ".gitattributes",
      ".npmrc",
      ".nvmrc",
      "LICENSE",
      "LICENSE-CODE",
      "SECURITY.md",
      "registry.json"
    ],
    "riders": [
      {
        "pattern": ".changeset/**",
        "fallback": "governance"
      },
      {
        "pattern": "management/orders/**",
        "fallback": "governance"
      }
    ],
    "lanes": [
      {
        "pattern": "play/*",
        "layer": "solution",
        "allow": ["plays/**"]
      },
      {
        "pattern": "governance/*",
        "layer": "governance",
        "allow": [
          ".github/**",
          ".husky/**",
          "khai-guard.config.json",
          "tests/**",
          "README.md",
          "GEMINI.md",
          "AGENTS.md",
          "CLAUDE.md",
          "PERPLEXITY.md",
          "REFERENCE.md",
          "REFERENCES.md",
          "management/**",
          "audit/**"
        ]
      },
      {
        "pattern": "changeset-release/*",
        "layer": "general",
        "allow": []
      },
      {
        "pattern": "dependabot/*",
        "layer": "general",
        "allow": ["**/package.json", "**/package-lock.json", ".github/workflows/**"]
      },
      {
        "pattern": "chore/*",
        "layer": "general",
        "allow": []
      },
      {
        "pattern": "fix/*",
        "layer": "general",
        "allow": []
      },
      {
        "pattern": "docs/*",
        "layer": "general",
        "allow": []
      }
    ]
  }
}
