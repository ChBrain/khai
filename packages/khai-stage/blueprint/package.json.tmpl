{
  "name": "@chbrain/{{BASE}}",
  "version": "0.0.0",
  "description": "{{HOUSE_DESCRIPTION}}",
  "type": "module",
  "exports": {
    ".": "./package.json",
    "./package.json": "./package.json",
    "./registry.json": "./registry.json"
  },
  "license": "SEE LICENSE IN LICENSE and LICENSE-CODE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChBrain/{{BASE}}.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "{{COLLECTION}}/**",
    "registry.json",
    "README.md",
    "LICENSE",
    "LICENSE-CODE"
  ],
  "khai": {
    "engine": "{{ENGINE}}",
    "card": {
      "wire": "{{HOUSE_WIRE}}"
    }
  },
  "scripts": {
    "prepare": "husky",
    "test": "vitest run",
    "gates": "khai-tests gates . --content-root {{COLLECTION}}/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version": "changeset version && khai-tests registry build && npm install --package-lock-only",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@chbrain/khai-arch": "^0.1.26",
    "@chbrain/khai-language": "^0.1.25",
    "@chbrain/khai-tests": "^0.4.1",
    "@chbrain/khai-guard": "^0.3.1",
    "@chbrain/khai-review": "^0.1.5",
    "@chbrain/khai-pack": "^0.0.3",
    "@chbrain/khai-stage": "^0.0.25",
    "vitest": "^4.1.11",
    "prettier": "^3.9.6",
    "husky": "^9.1.0"
  }
}
